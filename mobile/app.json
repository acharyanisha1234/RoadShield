{
  "expo": {
    "name": "RoadShield",
    "slug": "roadshield",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "roadshield",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.roadshield.app"
    },
    "android": {
      "package": "com.roadshield.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "RoadShield needs your location to report incidents."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RoadShield needs access to your photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}